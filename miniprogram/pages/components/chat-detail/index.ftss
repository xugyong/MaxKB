.chat-detail-mask {
  position: absolute;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.28);
}

.chat-detail-panel {
  position: absolute;
  right: 0;
  top: 0;
  width: 72%;
  height: 100%;
  background: #fff;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-detail-header,
.chat-detail-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
